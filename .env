# ───────────────────────────────────────────────────────────
# Aegis Health — Jetson board .env
# ───────────────────────────────────────────────────────────

# Core / security
# (to rotate: python3 -c "import secrets;print(secrets.token_hex(32))")
AEGIS_SECRET_KEY=d072710c0177b0cf4dbdfd506ba40aa7eed844f359822f34cdf33ce087baa147
AEGIS_ENV=production
COOKIE_SECURE=true

# Ollama — left exactly as your repo has it (only the base URL uses the host gateway)
AEGIS_OLLAMA_BASE_URL=http://172.17.0.1:11434
AEGIS_OLLAMA_MODEL=llama3.2:1b
OLLAMA_NUM_CTX=3072
OLLAMA_NUM_PREDICT=768
OLLAMA_TEMPERATURE=0.2

# CORS / public URL  (update the ngrok URL if it changes between sessions)
AEGIS_CORS_ORIGINS=["https://scrounger-headstone-entrench.ngrok-free.dev"]
AEGIS_PUBLIC_URL=https://scrounger-headstone-entrench.ngrok-free.dev

# Piper TTS — separate worker process (hybrid: prewarm at boot, kill on idle)
AEGIS_TTS_MODEL_DIR=data/audio/piper-en-gb-jenny-medium
AEGIS_TTS_VOICE_NAME=en_GB-jenny_dioco-medium
AEGIS_TTS_MAX_CHARS=20000
AEGIS_TTS_IDLE_EVICT_SECS=300     # kill worker after 5 min idle -> RAM reclaimed (0 = keep forever)
AEGIS_PIPER_THREADS=2             # ONNX threads in the worker (1 = lowest spike, 2 = faster)
AEGIS_PIPER_PORT=9880
AEGIS_PIPER_LOG=/tmp/aegis_piper_worker.log
AEGIS_PIPER_PIDFILE=/tmp/aegis_piper_worker.pid
